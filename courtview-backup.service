[Unit]
Description=CourtView nightly encrypted DB backup
After=network.target

[Service]
Type=oneshot
User=courtview
Group=courtview
UMask=0077
WorkingDirectory=/opt/courtview/current
ExecStart=/usr/bin/python3 /opt/courtview/current/cv_backup.py
Nice=10
IOSchedulingClass=idle
SyslogIdentifier=courtview-backup
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=COURTVIEW_DATA_DIR=/var/lib/courtview

# Same sandbox as courtview.service, minus network. It reads the DB it owns, writes
# /var/lib/courtview/backups and reads the public key from the release dir.
StateDirectory=courtview
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/courtview
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes
MemoryMax=512M
